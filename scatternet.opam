# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml scattering toolkit"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.20"}
  "gsl"
  "owl"
  "pyml"
  "sqlite3"
  "ppx_inline_test"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
