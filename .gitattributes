# dune build files -- no extension, so linguist won't classify these
# without an explicit override.
dune linguist-language=Dune
dune-project linguist-language=Dune

# OCaml sources, including .mll (ocamllex) -- Linguist's own languages.yml
# classifies .mll under OCaml itself, there's no separate "OCaml-lex" entry.
*.ml  diff=ocaml linguist-language=OCaml
*.mli diff=ocaml linguist-language=OCaml
*.mll diff=ocaml linguist-language=OCaml

# sqlite3 databases -- binary blobs, never diff/merge as text.
*.db      binary
*.sqlite  binary
*.sqlite3 binary
